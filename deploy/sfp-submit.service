[Unit]
Description=SFP Submission Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/github/paradigmxyz/sfp
ExecStart=/home/ubuntu/.local/bin/uvicorn scripts.submit_server:app --host 0.0.0.0 --port 8090
Restart=always
RestartSec=5
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
